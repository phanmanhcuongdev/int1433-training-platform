{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/int1433-training-platform/exercise.schema.json",
  "title": "INT1433 Exercise",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "title",
    "track",
    "technology",
    "difficulty",
    "level",
    "source_label",
    "statement",
    "processing_requirement",
    "common_failures",
    "tags",
    "estimated_time"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string" },
    "display_order": { "type": "number" },
    "status": { "type": "string", "enum": ["DRAFT", "REVIEWED", "PUBLISHED", "DEPRECATED"] },
    "track": { "type": "string", "enum": ["EXAM", "EXTENDED_NETWORKING", "BACKEND_DISTRIBUTED"] },
    "technology": { "type": "string", "minLength": 1 },
    "difficulty": { "type": "string", "enum": ["EASY", "MEDIUM", "HARD"] },
    "level": { "type": "string", "enum": ["L0", "L1", "L2", "L3", "L4", "L5", "L6"] },
    "source_label": { "type": "string", "enum": ["OBSERVED", "STRONG_PATTERN", "EXTENDED", "CHALLENGE"] },
    "statement": { "type": "string", "minLength": 1 },
    "processing_requirement": { "type": "string", "minLength": 1 },
    "common_failures": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "tags": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "estimated_time": { "type": "string", "minLength": 1 },
    "learning_objectives": { "type": "array", "items": { "type": "string" } },
    "protocol": { "type": "string" },
    "transport": { "type": "string" },
    "stream_type": { "type": "string" },
    "source_claim_ids": { "type": "array", "items": { "type": "string" } },
    "source_files": { "type": "array", "items": { "type": "string" } },
    "prerequisites": { "type": "array", "items": { "type": "string" } },
    "server_contract": { "type": "object" },
    "request_format": { "type": "string" },
    "response_format": { "type": "string" },
    "submission_format": { "type": "string" },
    "timeout": { "type": "object" },
    "starter_code": { "type": ["object", "string"] },
    "hidden_cases": { "type": "array", "items": { "type": "string" } },
    "hints": { "type": "array", "items": { "type": "string" } },
    "solution": { "type": ["object", "string"] },
    "explanation": { "type": "string" },
    "extensions": { "type": "array", "items": { "type": "string" } },
    "judge": { "type": "object" }
  }
}
