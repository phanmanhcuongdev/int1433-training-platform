APP_VERSION=0.4.1
GHCR_REGISTRY=ghcr.io
GHCR_OWNER=replace-with-lowercase-owner

POSTGRES_DB=int1433
POSTGRES_USER=int1433
POSTGRES_PASSWORD=replace-with-long-random-secret

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
WEB_HTTP_PORT=80

CHALLENGE_BIND_HOST=0.0.0.0
CHALLENGE_PUBLIC_HOST=int1433.example.com

CHALLENGE_TCP_PORT_MIN=19000
CHALLENGE_TCP_PORT_MAX=19020
CHALLENGE_UDP_PORT_MIN=19100
CHALLENGE_UDP_PORT_MAX=19120

RMI_REGISTRY_PORT=19200
RMI_PUBLIC_HOST=int1433.example.com

JAVA_RUNNER_IMAGE=ghcr.io/replace-owner/int1433-java-runner:0.4.1
JAVA_RUNNER_WORKSPACE_ROOT=/var/lib/int1433/runner-workspaces
JAVA_RUNNER_MAX_CONCURRENT=3
DOCKER_GID=replace-with-docker-socket-gid
JAVA_RUNNER_MEMORY_MB=256
JAVA_RUNNER_PIDS_LIMIT=32
JAVA_RUNNER_CPUS=1.0

MAX_ACTIVE_SESSIONS_PER_PARTICIPANT=3
MAX_GLOBAL_ACTIVE_SESSIONS=20
BACKEND_JAVA_TOOL_OPTIONS=-Xmx1g
